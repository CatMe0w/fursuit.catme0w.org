---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Lightbox from "../components/Lightbox.astro";

export type BackButtonMode = "none" | "archive" | "home" | "defer";

interface Props {
  title: string;
  description?: string;
  backButton?: BackButtonMode;
  lang?: string;
}

const { title, description, backButton = "none", lang = "zh-CN" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <slot name="head" />
    {/* 图片加载完成后标记data-loaded以取消灰色占位，见global.css，放在head中以赶在任何图片加载之前注册 */}
    <script is:inline>document.addEventListener("load",e=>(e=e.target).matches(".img-placeholder")&&(e.dataset.loaded=1),1)</script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar backButton={backButton} />
    <Lightbox>
      <slot />
    </Lightbox>
  </body>
</html>
