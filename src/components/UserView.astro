---
import ArchiveLayout from "../layouts/ArchiveLayout.astro";
import Pagination from "./Pagination.svelte";
import Sidebar from "./Sidebar.astro";
import SearchBox from "./SearchBox.astro";
import ExternalLinkButton from "./ExternalLinkButton.astro";
import UserHeader from "./UserHeader.svelte";
import UserRecordItem from "./UserRecordItem.svelte";
import VandalWarning from "./VandalWarning.svelte";
import { getUserRecords } from "../lib/data";
import { paginate } from "../lib/pagination";
import type { SearchResult, User, UserRecord } from "../lib/types";
import TimeMachineButton from "./TimeMachineButton.astro";
import { formatIsoDate, getAvatarUrl, getUserDisplayName, toMetaDescription } from "../lib/content-utils";
import { buildPerson, serializeJsonLd } from "../lib/structured-data";

interface Props {
  user: User;
  userId: number;
  currentPage: number;
  title: string;
}

const { user, userId, currentPage, title } = Astro.props as Props;

// 加载用户记录并分页
const allRecords = getUserRecords(userId);
const paginationResult = paginate(allRecords, currentPage, 30);

function mapRecordToSearchResult(record: UserRecord): SearchResult {
  return {
    threadId: record.threadId,
    postId: record.postId,
    commentId: record.commentId || null,
    resultType: record.type,
    time: record.time,
    userId: null,
    title: record.title,
    floor: record.floor,
    content: record.type === "comment" ? record.commentContent || [] : record.postContent || [],
    post_content_json: record.type === "comment" ? record.postContent || [] : undefined,
    page: record.page,
  };
}

const svelteRecords: SearchResult[] = paginationResult.items.map(mapRecordToSearchResult);

const userInfo: User = {
  id: user.id,
  username: user.username,
  nickname: user.nickname,
  avatar: user.avatar,
};

// JSON-LD
// https://developers.google.com/search/docs/appearance/structured-data/profile-page
const profileUrl = new URL(`/user/${userId}`, Astro.site).href;
const pageUrl = new URL(paginationResult.currentPage > 1 ? `/user/${userId}/${paginationResult.currentPage}` : `/user/${userId}`, Astro.site).href;
const person = buildPerson(Astro.site, userId, user.username, user.nickname);
const postCount = allRecords.filter((record) => record.type === "post").length;
const commentCount = allRecords.length - postCount;
const firstRecordTime = allRecords.reduce<string | null>((min, record) => (record.time && (!min || record.time < min) ? record.time : min), null);

// meta description
const threadCount = allRecords.filter((record) => record.type === "post" && record.floor === 1).length;
const lastRecordTime = allRecords.reduce<string | null>((max, record) => (record.time && (!max || record.time > max) ? record.time : max), null);
const displayName = getUserDisplayName(user) || `用户${userId}`;
const nameWithUsername = user.nickname && user.username && user.nickname !== user.username ? `${user.nickname}（${user.username}）` : displayName;
const statParts = [
  threadCount && `${threadCount}个主题帖`,
  postCount - threadCount && `${postCount - threadCount}条回复`,
  commentCount && `${commentCount}条楼中楼`,
].filter(Boolean);
const firstYear = firstRecordTime?.slice(0, 4);
const lastYear = lastRecordTime?.slice(0, 4);
const activeYears = firstYear && lastYear ? (firstYear === lastYear ? `，活跃于${firstYear}年` : `，活跃于${firstYear}年至${lastYear}年`) : "";
const description = toMetaDescription(
  (statParts.length > 0 ? `${nameWithUsername}在fursuit吧共发表${statParts.join("、")}${activeYears}。` : `${nameWithUsername}的fursuit吧用户页。`) +
    (paginationResult.currentPage > 1 ? `第${paginationResult.currentPage}页。` : ""),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: pageUrl,
  dateCreated: firstRecordTime ? formatIsoDate(firstRecordTime) : undefined,
  mainEntity: {
    ...person,
    "@id": profileUrl,
    alternateName: user.nickname && user.username && user.nickname !== user.username ? user.username : undefined,
    identifier: String(userId),
    image: user.avatar ? getAvatarUrl(user.avatar) : undefined,
    sameAs: [`https://tieba.baidu.com/home/main?id=${userId}`],
    agentInteractionStatistic: [
      { "@type": "InteractionCounter", interactionType: "https://schema.org/WriteAction", userInteractionCount: postCount },
      { "@type": "InteractionCounter", interactionType: "https://schema.org/CommentAction", userInteractionCount: commentCount },
    ],
  },
};
---

<ArchiveLayout title={title} description={description} ogType="profile" ogImage={user.avatar ? { url: getAvatarUrl(user.avatar) } : undefined}>
  <script is:inline type="application/ld+json" slot="head" set:html={serializeJsonLd(jsonLd)} />
  <div class="bg-gray-50 lg:mx-1 my-2">
    <div class="shadow lg:rounded bg-white">
      <UserHeader client:load user={userInfo} currentPage={paginationResult.currentPage} totalPages={paginationResult.totalPages} baseUrl={`/user/${userId}`} />
      <VandalWarning userId={userId} />
      <div class="grid grid-cols-1">
        {svelteRecords.map((record) => <UserRecordItem item={record} />)}
        <div class="flex p-5 justify-end">
          <Pagination
            client:load
            currentPage={paginationResult.currentPage}
            totalPages={paginationResult.totalPages}
            baseUrl={`/user/${userId}`}
            forceFullWidth
          />
        </div>
      </div>
    </div>
  </div>
  <div id="sidebar-container" slot="sidebar">
    <Sidebar searchOnly>
      <SearchBox placeholder="搜索该用户" action={`/search?scope=user&user_id=${userId}`} />
    </Sidebar>
    <Sidebar>
      <h1 slot="title">到别处看看</h1>
      <TimeMachineButton currentScope="user" resourceId={userId} />
      <a href="/moderation-logs/post" class="bg-gray-100 hover:bg-gray-200 active:bg-gray-300 text-gray-600 px-4 py-1.5 rounded block transition-colors">吧务后台日志</a>
      <div class="border-2 border-b border-gray-100 my-1"></div>
      <ExternalLinkButton href={`https://tieba.baidu.com/home/main?id=${user.id}`}>用户页（百度贴吧）</ExternalLinkButton>
      <ExternalLinkButton href={`https://web.archive.org/web/*/https://tieba.baidu.com/home/main?id=${user.id}`}>用户页（网页存档）</ExternalLinkButton>
    </Sidebar>
  </div>
</ArchiveLayout>
